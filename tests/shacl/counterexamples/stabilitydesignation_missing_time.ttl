@prefix svt: <https://w3id.org/sysmlv2-testing#> .
@prefix svtid: <https://w3id.org/sysmlv2-testing/id/> .

svtid:implementation-ok a svt:Implementation ;
    svt:name "ok" ;
    svt:repositoryURL "https://example.org/ok" ;
    svt:primaryLanguage "Go" .

svtid:version-ok a svt:Version ;
    svt:ofImplementation svtid:implementation-ok ;
    svt:commitHash "abc1234" .

svtid:stability-broken a svt:StabilityDesignation ;
    svt:designates svtid:version-ok ;
    svt:forImplementation svtid:implementation-ok .
# missing prov:startedAtTime -- violates svt:StabilityDesignationShape
