@prefix svt: <https://w3id.org/sysmlv2-testing#> .
@prefix svtid: <https://w3id.org/sysmlv2-testing/id/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

svtid:implementation-ok a svt:Implementation ;
    svt:name "ok" ;
    svt:repositoryURL "https://example.org/ok" ;
    svt:primaryLanguage "Go" .

svtid:version-ok a svt:Version ;
    svt:ofImplementation svtid:implementation-ok ;
    svt:commitHash "abc1234" .

svtid:stability-ok a svt:StabilityDesignation ;
    svt:designates svtid:version-ok ;
    svt:forImplementation svtid:implementation-ok ;
    prov:startedAtTime "2026-01-01T00:00:00"^^xsd:dateTime .

svtid:spec-ok a svt:SpecDocument ;
    svt:docNumber "formal/0000-00-00" ;
    svt:localPath "sources/local/ok.pdf" ;
    svt:sha256 "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" .

svtid:citation-ok a svt:SpecCitation ;
    svt:citesDocument svtid:spec-ok ;
    svt:section "1 Ok" ;
    svt:page "1" ;
    svt:quote "ok is ok" .

svtid:resolutioncheck-ok a svt:ResolutionCheck ;
    svt:subjectFeature "UsageTwo::c::@0" ;
    svt:expectedTarget "Lib::Container::items" .

svtid:intent-ok a svt:TestIntent ;
    svt:question "Is this model accepted?" ;
    svt:concerns "admissibility" .

svtid:testcase-ok a svt:TestCase ;
    svt:description "ok" ;
    svt:hasInputFile "input.sysml" ;
    svt:method "structural-check" ;
    svt:expected "clean" ;
    svt:priorState "fresh" ;
    svt:events "SomeEvent" ;
    svt:checksResolution svtid:resolutioncheck-ok ;
    svt:groundedIn svtid:citation-ok ;
    svt:realizesIntent svtid:intent-ok .

svtid:person-ok a prov:Person ;
    rdfs:label "Ok Human" .

svtid:validation-ok a svt:Validation ;
    svt:validates svtid:testcase-ok ;
    prov:wasAssociatedWith svtid:person-ok ;
    prov:startedAtTime "2026-01-01T00:00:00"^^xsd:dateTime .

svtid:agent-ok a earl:Software .

svtid:result-ok a earl:TestResult ;
    earl:outcome earl:passed ;
    earl:info "expected='clean' actual='clean'" ;
    svt:actual "clean" .

svtid:invocation-ok a svt:Invocation ;
    svt:command "sysmlv2 check --strict input.sysml" ;
    svt:exitCode 0 ;
    svt:stdout "clean" ;
    svt:stderr "" ;
    svt:inputDigest "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" ;
    prov:startedAtTime "2026-01-01T00:00:00"^^xsd:dateTime .

svtid:run-ok a svt:TestRun ;
    earl:test svtid:testcase-ok ;
    earl:subject svtid:version-ok ;
    earl:assertedBy svtid:agent-ok ;
    earl:mode earl:automatic ;
    earl:result svtid:result-ok ;
    svt:hasInvocation svtid:invocation-ok ;
    svt:ranBy svtid:party-a ;
    svt:reconfirmedAt "2026-01-03T00:00:00"^^xsd:dateTime ;
    prov:startedAtTime "2026-01-01T00:00:00"^^xsd:dateTime .

svtid:party-a a svt:Party, prov:SoftwareAgent ;
    rdfs:label "machine A" .

svtid:party-b a svt:Party, prov:SoftwareAgent ;
    rdfs:label "machine B" .

svtid:result-reproduced-ok a earl:TestResult ;
    earl:outcome earl:passed ;
    earl:info "expected='clean' actual='clean'" ;
    svt:actual "clean" .

svtid:invocation-reproduced-ok a svt:Invocation ;
    svt:command "sysmlv2 check --strict input.sysml" ;
    svt:exitCode 0 ;
    svt:stdout "clean" ;
    svt:stderr "" ;
    svt:inputDigest "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" ;
    prov:startedAtTime "2026-01-02T00:00:00"^^xsd:dateTime .

svtid:reproduction-ok a svt:Reproduction ;
    svt:concernsRun svtid:run-ok ;
    svt:ranBy svtid:party-b ;
    earl:result svtid:result-reproduced-ok ;
    svt:hasInvocation svtid:invocation-reproduced-ok ;
    prov:startedAtTime "2026-01-02T00:00:00"^^xsd:dateTime .

svtid:annotation-ok a svt:Annotation ;
    svt:concernsRun svtid:run-ok ;
    prov:wasAssociatedWith svtid:person-ok ;
    prov:startedAtTime "2026-01-01T00:00:00"^^xsd:dateTime ;
    svt:comment "looked odd, worth a second look" .

svtid:issuelink-ok a svt:IssueLink ;
    svt:concernsRun svtid:run-ok ;
    prov:wasAssociatedWith svtid:person-ok ;
    prov:startedAtTime "2026-01-01T00:00:00"^^xsd:dateTime ;
    svt:issueURL "https://example.org/issues/1"^^xsd:anyURI ;
    svt:issueLabel "example issue" .
