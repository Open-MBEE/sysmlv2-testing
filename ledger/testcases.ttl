@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix svt: <https://w3id.org/sysmlv2-testing#> .
@prefix svtid: <https://w3id.org/sysmlv2-testing/id/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

svtid:intent-anonymous-sibling-redefinition-target
    a svt:TestIntent ;
    svt:concerns "posterior-state" ;
    svt:question "Do several anonymous ':>> items' redefinitions of the same multi-valued reference feature each resolve to the inherited base feature, regardless of how many siblings there are?" .

svtid:intent-anonymous-sibling-redefinition-well-formed
    a svt:TestIntent ;
    svt:concerns "admissibility" ;
    svt:question "Must a model in which a multi-valued reference feature is redefined by several anonymous ':>> items' memberships be accepted as well-formed?" .

svtid:intent-constraint-evaluates-against-usage-bindings
    a svt:TestIntent ;
    svt:concerns "posterior-state" ;
    svt:question "Does an assert constraint evaluate against a usage's actual bound feature values rather than its declaration-site defaults?" .

svtid:intent-end-feature-redefinition-requires-end-keyword
    a svt:TestIntent ;
    svt:concerns "admissibility" ;
    svt:question "Does a connection-end redefinition have to carry the literal 'end' keyword to be accepted as well-formed?" .

svtid:intent-private-membership-not-visible-outside-namespace
    a svt:TestIntent ;
    svt:concerns "admissibility" ;
    svt:question "Must a model that references a private member from outside its owning namespace be rejected?" .

svtid:intent-state-machine-initial-and-transition-semantics
    a svt:TestIntent ;
    svt:concerns "posterior-state" ;
    svt:question "Which states does an exhibited state machine occupy, given its entry transition and a sequence of accepted events?" .

svtid:person-zargham
    a prov:Person ;
    rdfs:label "Zargham" .

svtid:resolutioncheck-174697fa0b754215
    a svt:ResolutionCheck ;
    svt:expectedTarget "Lib::Container::items" ;
    svt:subjectFeature "UsageTwo::c::@0" .

svtid:resolutioncheck-ab3ac9a1e4c6960b
    a svt:ResolutionCheck ;
    svt:expectedTarget "Lib::Container::items" ;
    svt:subjectFeature "UsageTwo::c::@1" .

svtid:resolutioncheck-cf995da9324ed91b
    a svt:ResolutionCheck ;
    svt:expectedTarget "Lib::Container::items" ;
    svt:subjectFeature "UsageThree::d::@2" .

svtid:resolutioncheck-d528d62c08b02686
    a svt:ResolutionCheck ;
    svt:expectedTarget "Lib::Container::items" ;
    svt:subjectFeature "UsageThree::d::@1" .

svtid:resolutioncheck-eceab5ff09836ca9
    a svt:ResolutionCheck ;
    svt:expectedTarget "Lib::Container::items" ;
    svt:subjectFeature "UsageThree::d::@0" .

svtid:testcase-constraint-eval-declaration-site
    a svt:TestCase ;
    svt:description "connection l : Link binds source=a (controlled=true) and target=b (controlled=false); Link's assert constraint 'source.controlled and target.controlled', evaluated against l's actual bound values, must be false." ;
    svt:evalExpression "source.controlled and target.controlled" ;
    svt:evalSubject "Usage::l" ;
    svt:expected "false" ;
    svt:groundedIn svtid:citation-assert-constraint-per-usage-evaluation ;
    svt:hasInputFile "lib.sysml",
        "usage.sysml" ;
    svt:method "constraint-eval" ;
    svt:realizesIntent svtid:intent-constraint-evaluates-against-usage-bindings .

svtid:testcase-end-feature-redefinition-bare
    a svt:TestCase ;
    svt:description "A connection-end redefinition written without the explicit 'end' keyword (bare ':>> source'/':>> target') must be rejected." ;
    svt:expected "violated" ;
    svt:groundedIn svtid:citation-check-feature-end-redefinition,
        svtid:citation-end-usage-prefix-grammar ;
    svt:hasInputFile "lib.sysml",
        "usage-bare-noncompliant.sysml" ;
    svt:method "structural-check" ;
    svt:realizesIntent svtid:intent-end-feature-redefinition-requires-end-keyword .

svtid:testcase-end-feature-redefinition-explicit
    a svt:TestCase ;
    svt:description "A connection-end redefinition written with the explicit 'end' keyword ('end :>> source'/'end :>> target') must be accepted." ;
    svt:expected "clean" ;
    svt:groundedIn svtid:citation-check-feature-end-redefinition,
        svtid:citation-end-usage-prefix-grammar ;
    svt:hasInputFile "lib.sysml",
        "usage-end-portable.sysml" ;
    svt:method "structural-check" ;
    svt:realizesIntent svtid:intent-end-feature-redefinition-requires-end-keyword .

svtid:testcase-end-feature-redefinition-explicit-reference-binding
    a svt:TestCase ;
    svt:description "A connection-end redefinition written with the explicit 'end' keyword and bound to its related element by reference ('end :>> source ::> a'/'end :>> target ::> b'), in a connection whose definition declares its end features without an additional explicit type, must be accepted." ;
    svt:expected "clean" ;
    svt:groundedIn svtid:citation-check-feature-end-redefinition,
        svtid:citation-end-usage-prefix-grammar ;
    svt:hasInputFile "lib.sysml",
        "usage-end-reference.sysml" ;
    svt:method "structural-check" ;
    svt:realizesIntent svtid:intent-end-feature-redefinition-requires-end-keyword .

svtid:testcase-membership-visibility-private-rejected
    a svt:TestCase ;
    svt:description "A part usage typed by a private part definition, referenced by qualified name from outside the definition's owning package, must be rejected -- the private member is not visible outside its owning namespace." ;
    svt:expected "violated" ;
    svt:groundedIn svtid:citation-membership-visibility-private ;
    svt:hasInputFile "private-visibility.sysml" ;
    svt:method "structural-check" ;
    svt:realizesIntent svtid:intent-private-membership-not-visible-outside-namespace .

svtid:testcase-redefinition-ambiguity-2
    a svt:TestCase ;
    svt:description "A model in which a multi-valued reference feature is redefined by two anonymous ':>> items' memberships must be accepted as well-formed." ;
    svt:expected "clean" ;
    svt:groundedIn svtid:citation-remove-redefined-features ;
    svt:hasInputFile "lib.sysml",
        "usage-two-ok.sysml" ;
    svt:method "structural-check" ;
    svt:realizesIntent svtid:intent-anonymous-sibling-redefinition-well-formed .

svtid:testcase-redefinition-ambiguity-2-resolution
    a svt:TestCase ;
    svt:checksResolution svtid:resolutioncheck-174697fa0b754215,
        svtid:resolutioncheck-ab3ac9a1e4c6960b ;
    svt:description "Each anonymous ':>> items' redefinition under part c must resolve, by real object identity, to the inherited base feature Container::items." ;
    svt:groundedIn svtid:citation-remove-redefined-features ;
    svt:hasInputFile "lib.sysml",
        "usage-two-ok.sysml" ;
    svt:method "reference-resolution" ;
    svt:realizesIntent svtid:intent-anonymous-sibling-redefinition-target .

svtid:testcase-redefinition-ambiguity-3plus
    a svt:TestCase ;
    svt:description "A model in which a multi-valued reference feature is redefined by three anonymous ':>> items' memberships must be accepted as well-formed, regardless of sibling count." ;
    svt:expected "clean" ;
    svt:groundedIn svtid:citation-remove-redefined-features ;
    svt:hasInputFile "lib.sysml",
        "usage-three-ambiguous.sysml" ;
    svt:method "structural-check" ;
    svt:realizesIntent svtid:intent-anonymous-sibling-redefinition-well-formed .

svtid:testcase-redefinition-ambiguity-3plus-resolution
    a svt:TestCase ;
    svt:checksResolution svtid:resolutioncheck-cf995da9324ed91b,
        svtid:resolutioncheck-d528d62c08b02686,
        svtid:resolutioncheck-eceab5ff09836ca9 ;
    svt:description "Each of the three anonymous ':>> items' redefinitions under part d must resolve, by real object identity, to the inherited base feature Container::items, regardless of sibling count." ;
    svt:groundedIn svtid:citation-remove-redefined-features ;
    svt:hasInputFile "lib.sysml",
        "usage-three-ambiguous.sysml" ;
    svt:method "reference-resolution" ;
    svt:realizesIntent svtid:intent-anonymous-sibling-redefinition-target .

svtid:testcase-state-machine-settles-without-events
    a svt:TestCase ;
    svt:description "A Surface's exhibited state machine, given no events (the command u is empty), must settle at its declared initial state dormant (entry; then dormant;)." ;
    svt:evalSubject "StateDemo::Surface::condition" ;
    svt:expected "dormant" ;
    svt:groundedIn svtid:citation-state-initial-via-entry-succession ;
    svt:hasInputFile "surface.sysml" ;
    svt:method "state-execution" ;
    svt:realizesIntent svtid:intent-state-machine-initial-and-transition-semantics .

svtid:testcase-state-machine-transitions-on-event
    a svt:TestCase ;
    svt:description "A Surface's exhibited state machine, given one EngagementEvent, must transition from dormant to active (transition first dormant accept EngagementEvent then active;)." ;
    svt:evalSubject "StateDemo::Surface::condition" ;
    svt:events "EngagementEvent" ;
    svt:expected "dormant,active" ;
    svt:groundedIn svtid:citation-state-initial-via-entry-succession ;
    svt:hasInputFile "surface.sysml" ;
    svt:method "state-execution" ;
    svt:realizesIntent svtid:intent-state-machine-initial-and-transition-semantics .

