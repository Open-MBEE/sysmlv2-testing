@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix svt: <https://w3id.org/sysmlv2-testing#> .
@prefix svtid: <https://w3id.org/sysmlv2-testing/id/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

svtid:testcase-constraint-eval-declaration-site
    a svt:TestCase ;
    svt:description "connection l : Link binds source=a (controlled=true) and target=b (controlled=false); Link's assert constraint 'source.controlled and target.controlled' evaluated against l's actual bound values must be false, not Link's own declaration-site defaults." ;
    svt:evalExpression "source.controlled and target.controlled" ;
    svt:evalSubject "Usage::l" ;
    svt:expected "false" ;
    svt:groundedIn svtid:citation-assert-constraint-per-usage-evaluation ;
    svt:hasInputFile "lib.sysml",
        "usage.sysml" ;
    svt:method "constraint-eval" .

svtid:testcase-end-feature-redefinition-bare
    a svt:TestCase ;
    svt:description "Bare ':>> source'/':>> target' redefinition of a connection's end feature (no explicit 'end' keyword). Grounded: SysML v2.0 Part 1 s8.4.9.2's checkFeatureEndRedefinition constraint plus the isEnd grammar rule (s8.2.2.6.2) require the literal 'end' keyword on a feature that redefines an end feature -- this form should be rejected." ;
    svt:expected "violated" ;
    svt:groundedIn svtid:citation-check-feature-end-redefinition,
        svtid:citation-end-usage-prefix-grammar ;
    svt:hasInputFile "lib.sysml",
        "usage-bare-noncompliant.sysml" ;
    svt:method "structural-check" .

svtid:testcase-end-feature-redefinition-explicit
    a svt:TestCase ;
    svt:description "Explicit 'end :>> source'/'end :>> target' redefinition of a connection's end feature -- the uncontroversial, portable form." ;
    svt:expected "clean" ;
    svt:groundedIn svtid:citation-check-feature-end-redefinition,
        svtid:citation-end-usage-prefix-grammar ;
    svt:hasInputFile "lib.sysml",
        "usage-end-portable.sysml" ;
    svt:method "structural-check" .

svtid:testcase-redefinition-ambiguity-2
    a svt:TestCase ;
    svt:description "Two anonymous ':>> items' redefinitions of a multi-valued reference feature should both resolve to the inherited base feature Container::items." ;
    svt:expected "clean" ;
    svt:groundedIn svtid:citation-remove-redefined-features ;
    svt:hasInputFile "lib.sysml",
        "usage-two-ok.sysml" ;
    svt:method "structural-check" .

svtid:testcase-redefinition-ambiguity-3plus
    a svt:TestCase ;
    svt:description "Three anonymous ':>> items' redefinitions of a multi-valued reference feature should all resolve to the inherited base feature Container::items, same as with two -- sibling count should not matter." ;
    svt:expected "clean" ;
    svt:groundedIn svtid:citation-remove-redefined-features ;
    svt:hasInputFile "lib.sysml",
        "usage-three-ambiguous.sysml" ;
    svt:method "structural-check" .
