    a svt:ResolutionCheck ;
    svt:expectedTarget "Lib::Container::items" ;
    svt:subjectFeature "UsageTwo::c::@0" .

svtid:resolutioncheck-ab3ac9a1e4c6960b
    a svt:ResolutionCheck ;
    svt:expectedTarget "Lib::Container::items" ;
    svt:subjectFeature "UsageTwo::c::@1" .

svtid:resolutioncheck-cf995da9324ed91b
    a svt:ResolutionCheck ;
