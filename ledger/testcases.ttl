svtid:testcase-constraint-eval-declaration-site
    a svt:TestCase ;
    svt:description "connection l : Link binds source=a (controlled=true) and target=b (controlled=false); Link's assert constraint 'source.controlled and target.controlled', evaluated against l's actual bound values, must be false." ;
    svt:evalExpression "source.controlled and target.controlled" ;
    svt:evalSubject "Usage::l" ;
    svt:expected "false" ;
    svt:groundedIn svtid:citation-assert-constraint-per-usage-evaluation ;
    svt:hasInputFile "lib.sysml",
        "usage.sysml" ;
    svt:method "constraint-eval" .

svtid:testcase-end-feature-redefinition-bare
    a svt:TestCase ;
    svt:description "A connection-end redefinition written without the explicit 'end' keyword (bare ':>> source'/':>> target') must be rejected." ;
    svt:expected "violated" ;
    svt:groundedIn svtid:citation-check-feature-end-redefinition,
        svtid:citation-end-usage-prefix-grammar ;
    svt:hasInputFile "lib.sysml",
        "usage-bare-noncompliant.sysml" ;
    svt:method "structural-check" .

svtid:testcase-end-feature-redefinition-explicit
    a svt:TestCase ;
    svt:description "A connection-end redefinition written with the explicit 'end' keyword ('end :>> source'/'end :>> target') must be accepted." ;
    svt:expected "clean" ;
    svt:groundedIn svtid:citation-check-feature-end-redefinition,
        svtid:citation-end-usage-prefix-grammar ;
    svt:hasInputFile "lib.sysml",
        "usage-end-portable.sysml" ;
    svt:method "structural-check" .

svtid:testcase-membership-visibility-private-rejected
    a svt:TestCase ;
    svt:description "A part usage typed by a private part definition, referenced by qualified name from outside the definition's owning package, must be rejected -- the private member is not visible outside its owning namespace." ;
    svt:expected "violated" ;
    svt:groundedIn svtid:citation-membership-visibility-private ;
    svt:hasInputFile "private-visibility.sysml" ;
    svt:method "structural-check" .

svtid:testcase-redefinition-ambiguity-2
    a svt:TestCase ;
    svt:description "Two anonymous ':>> items' redefinitions of a multi-valued reference feature should both resolve to the inherited base feature Container::items." ;
    svt:expected "clean" ;
    svt:groundedIn svtid:citation-remove-redefined-features ;
    svt:hasInputFile "lib.sysml",
        "usage-two-ok.sysml" ;
    svt:method "structural-check" .

svtid:testcase-redefinition-ambiguity-2-resolution
    a svt:TestCase ;
    svt:checksResolution svtid:resolutioncheck-174697fa0b754215,
        svtid:resolutioncheck-ab3ac9a1e4c6960b ;
    svt:description "Each anonymous ':>> items' redefinition under part c must resolve, by real object identity, to the inherited base feature Container::items." ;
    svt:groundedIn svtid:citation-remove-redefined-features ;
    svt:hasInputFile "lib.sysml",
        "usage-two-ok.sysml" ;
    svt:method "reference-resolution" .

svtid:testcase-redefinition-ambiguity-3plus
    a svt:TestCase ;
    svt:description "Three anonymous ':>> items' redefinitions of a multi-valued reference feature must all resolve to the inherited base feature Container::items, regardless of sibling count." ;
    svt:expected "clean" ;
    svt:groundedIn svtid:citation-remove-redefined-features ;
    svt:hasInputFile "lib.sysml",
        "usage-three-ambiguous.sysml" ;
    svt:method "structural-check" .

svtid:testcase-redefinition-ambiguity-3plus-resolution
    a svt:TestCase ;
    svt:checksResolution svtid:resolutioncheck-cf995da9324ed91b,
        svtid:resolutioncheck-d528d62c08b02686,
        svtid:resolutioncheck-eceab5ff09836ca9 ;
    svt:description "Each of the three anonymous ':>> items' redefinitions under part d must resolve, by real object identity, to the inherited base feature Container::items, regardless of sibling count." ;
    svt:groundedIn svtid:citation-remove-redefined-features ;
    svt:hasInputFile "lib.sysml",
        "usage-three-ambiguous.sysml" ;
    svt:method "reference-resolution" .

svtid:testcase-state-machine-settles-without-events
    a svt:TestCase ;
    svt:description "A Surface's exhibited state machine, given no events (the command u is empty), must settle at its declared initial state dormant (entry; then dormant;)." ;
    svt:evalSubject "StateDemo::Surface::condition" ;
    svt:expected "dormant" ;
    svt:groundedIn svtid:citation-state-initial-via-entry-succession ;
    svt:hasInputFile "surface.sysml" ;
    svt:method "state-execution" .

svtid:testcase-state-machine-transitions-on-event
    a svt:TestCase ;
    svt:description "A Surface's exhibited state machine, given one EngagementEvent, must transition from dormant to active (transition first dormant accept EngagementEvent then active;)." ;
    svt:evalSubject "StateDemo::Surface::condition" ;
    svt:events "EngagementEvent" ;
    svt:expected "dormant,active" ;
    svt:groundedIn svtid:citation-state-initial-via-entry-succession ;
    svt:hasInputFile "surface.sysml" ;
    svt:method "state-execution" .

