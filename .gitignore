# The two OMG spec PDFs are copyrighted — held locally, never committed.
# sources/sources.ttl (committed) records their sha256 so anyone can verify
# their own copy is the same edition.
sources/local/*.pdf

# Python / uv
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Pinned toolchain caches (binaries/jars fetched or built by toolchain/*.sh —
# reproducible from a Version's commitHash/artifactDigest, never committed).
# Everything actually lands under .cache/<implementation>/<commit>/ --
# toolchain/get-pilot-jar.sh and get-sysml-toolkit.sh confirmed directly,
# neither writes anywhere under toolchain/ or adapters/pilot_glue/ itself.
.cache/

/tmp-gate-out*

# `svt view` output -- compiled Markdown reports, fully reproducible from
# the ledger + fixtures at any time. Ephemeral by design, never committed.
reports/
