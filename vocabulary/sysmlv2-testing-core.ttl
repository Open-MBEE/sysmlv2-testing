@prefix svt: <https://w3id.org/sysmlv2-testing#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# sysmlv2-testing core vocabulary.
#
# Four classes, every one a subclass of a W3C EARL or PROV-O class — this
# vocabulary never redefines what EARL/PROV-O already mean, it only adds the
# SysML-v2-testing-specific properties those classes carry. See AGENTS.md
# for the pipeline these four classes support: run a pinned tool against a
# TestCase's input, capture raw output, compare it to an expected literal
# with a scripted comparator, log the result as a TestRun.

<https://w3id.org/sysmlv2-testing#> a owl:Ontology ;
    rdfs:label "sysmlv2-testing core vocabulary" ;
    rdfs:comment "Classes and properties for a testing ledger tracking SysML v2 implementations, built as a thin extension of EARL and PROV-O." .

#################################################################
# svt:Implementation
#################################################################

svt:Implementation a owl:Class ;
    rdfs:subClassOf prov:SoftwareAgent, earl:TestSubject ;
    rdfs:label "Implementation" ;
    rdfs:comment "A SysML v2 tool under test (e.g. the Pilot Implementation, OpenSysML, sysml-toolkit)." .

svt:name a owl:DatatypeProperty ;
    rdfs:domain svt:Implementation ;
    rdfs:range xsd:string ;
    rdfs:label "name" .

svt:repositoryURL a owl:DatatypeProperty ;
    rdfs:domain svt:Implementation ;
    rdfs:range xsd:anyURI ;
    rdfs:label "repository URL" .

svt:primaryLanguage a owl:DatatypeProperty ;
    rdfs:domain svt:Implementation ;
    rdfs:range xsd:string ;
    rdfs:label "primary language" .

svt:hasVersion a owl:ObjectProperty ;
    rdfs:domain svt:Implementation ;
    rdfs:range svt:Version ;
    rdfs:label "has version" .

#################################################################
# svt:Version
#################################################################

svt:Version a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Version" ;
    rdfs:comment "One precise, git-hash-identified point in an Implementation's history." .

svt:ofImplementation a owl:ObjectProperty ;
    rdfs:domain svt:Version ;
    rdfs:range svt:Implementation ;
    owl:inverseOf svt:hasVersion ;
    rdfs:label "of implementation" .

svt:commitHash a owl:DatatypeProperty ;
    rdfs:domain svt:Version ;
    rdfs:range xsd:string ;
    rdfs:label "commit hash" ;
    rdfs:comment "The exact git SHA this Version identifies. Required — see shapes/version.shapes.ttl." .

svt:versionLabel a owl:DatatypeProperty ;
    rdfs:domain svt:Version ;
    rdfs:range xsd:string ;
    rdfs:label "version label" ;
    rdfs:comment "A human tag or date string (e.g. \"v0.6.0\" or \"2026-08\"); not a substitute for commitHash." .

svt:sourceURL a owl:DatatypeProperty ;
    rdfs:domain svt:Version ;
    rdfs:range xsd:anyURI ;
    rdfs:label "source URL" .

svt:artifactDigest a owl:DatatypeProperty ;
    rdfs:domain svt:Version ;
    rdfs:range xsd:string ;
    rdfs:label "artifact digest" ;
    rdfs:comment "sha256 of a built or downloaded binary/jar pinned for this Version, distinct from commitHash." .

#################################################################
# svt:StabilityDesignation — append-only; never overwrite a Version's
# "current stable" status, add a new designation with a later timestamp.
#################################################################

svt:StabilityDesignation a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Stability designation" ;
    rdfs:comment "An append-only record that a Version was, as of prov:startedAtTime, the designated-stable release of an Implementation. \"Current stable\" is a query (latest startedAtTime per Implementation), never a mutable field. (prov:startedAtTime, not prov:generatedAtTime -- the latter's rdfs:domain is prov:Entity, and this is a prov:Activity; PROV-O declares Entity and Activity disjoint.)" .

svt:designates a owl:ObjectProperty ;
    rdfs:domain svt:StabilityDesignation ;
    rdfs:range svt:Version ;
    rdfs:label "designates" .

svt:forImplementation a owl:ObjectProperty ;
    rdfs:domain svt:StabilityDesignation ;
    rdfs:range svt:Implementation ;
    rdfs:label "for implementation" .

#################################################################
# svt:TestCase
#################################################################

svt:TestCase a owl:Class ;
    rdfs:subClassOf earl:TestCriterion ;
    rdfs:label "Test case" ;
    rdfs:comment "A state-transition claim: each Implementation under test is a candidate realization of a transition function f; given prior state x (svt:priorState, default: nothing but the standard library loaded) and command u (svt:hasInputFile, and for some methods svt:events/svt:evalExpression/svt:evalSubject), the correct posterior state is x+ = f_spec(x, u). svt:method selects which fact about that transition this TestCase checks: structural-check asks whether u is even admissible (u in U_x -- see AGENTS.md); constraint-eval, state-execution, and reference-resolution each assert a specific fact about the actual x+ once u is admitted. Grounded in real spec citations (svt:groundedIn), not bare assertions." .

svt:description a owl:DatatypeProperty ;
    rdfs:domain svt:TestCase ;
    rdfs:range xsd:string ;
    rdfs:label "description" .

svt:priorState a owl:DatatypeProperty ;
    rdfs:domain svt:TestCase ;
    rdfs:range xsd:string ;
    rdfs:label "prior state" ;
    rdfs:comment "x: the state this TestCase's command is applied against. Absent means the default prior state -- nothing but the standard library loaded, no prior command applied. Exists so a future multi-step scenario (one command's x+ feeding the next command's x) has an explicit place to record it, rather than an implicit, untracked assumption." .

svt:hasInputFile a owl:DatatypeProperty ;
    rdfs:domain svt:TestCase ;
    rdfs:range xsd:string ;
    rdfs:label "has input file" ;
    rdfs:comment "A path (relative to ledger/fixtures/<testcase-id>/) of one file in this test case's input set -- part of the command u. Multivalued — a test case's input may be several files." .

svt:method a owl:DatatypeProperty ;
    rdfs:domain svt:TestCase ;
    rdfs:range xsd:string ;
    rdfs:label "method" ;
    rdfs:comment "Which scripted comparator applies, i.e. which fact about (x, u) -> x+ this TestCase checks: structural-check (is u in U_x -- admissibility only) | constraint-eval | state-execution | reference-resolution (facts about the actual x+, given an admissible u). See shapes/testcase.shapes.ttl for the closed set." .

svt:expected a owl:DatatypeProperty ;
    rdfs:domain svt:TestCase ;
    rdfs:range xsd:string ;
    rdfs:label "expected" ;
    rdfs:comment "The literal value the method's comparator checks captured output against (for structural-check/constraint-eval/state-execution; reference-resolution uses svt:checksResolution instead, since it asserts a set of facts, not one scalar). Absent when the correct behavior is not yet settled (e.g. pending a spec-text read) — a TestRun against such a TestCase mechanically records earl:cantTell, never a guess." .

svt:evalExpression a owl:DatatypeProperty ;
    rdfs:domain svt:TestCase ;
    rdfs:range xsd:string ;
    rdfs:label "eval expression" ;
    rdfs:comment "For method=constraint-eval: the boolean expression to evaluate." .

svt:evalSubject a owl:DatatypeProperty ;
    rdfs:domain svt:TestCase ;
    rdfs:range xsd:string ;
    rdfs:label "eval subject" ;
    rdfs:comment "For method=constraint-eval or state-execution: the fully-qualified usage/connection name the evaluation is performed against (subject_symbol_id)." .

svt:events a owl:DatatypeProperty ;
    rdfs:domain svt:TestCase ;
    rdfs:range xsd:string ;
    rdfs:label "events" ;
    rdfs:comment "For method=state-execution: the command u -- a comma-joined, ordered sequence of event names to feed the state machine (e.g. \"EngagementEvent\"). Absent means the zero-event default (does the machine settle correctly with nothing to react to)." .

svt:checksResolution a owl:ObjectProperty ;
    rdfs:domain svt:TestCase ;
    rdfs:range svt:ResolutionCheck ;
    rdfs:label "checks resolution" ;
    rdfs:comment "For method=reference-resolution: the set of resolution facts x+ must satisfy (multivalued -- a test case may need to check several redefinitions at once)." .

svt:ResolutionCheck a owl:Class ;
    rdfs:label "Resolution check" ;
    rdfs:comment "One fact about x+: the feature named svt:subjectFeature must resolve (via redefinition/specialization) to the feature named svt:expectedTarget. Checked by real per-implementation object identity, never by diagnostics alone -- see AGENTS.md." .

svt:subjectFeature a owl:DatatypeProperty ;
    rdfs:domain svt:ResolutionCheck ;
    rdfs:range xsd:string ;
    rdfs:label "subject feature" ;
    rdfs:comment "A locator for the feature whose resolution is being checked -- a qualified name where the implementation can resolve one, otherwise an implementation-specific positional locator (e.g. \"UsageTwo::c::@0\")." .

svt:expectedTarget a owl:DatatypeProperty ;
    rdfs:domain svt:ResolutionCheck ;
    rdfs:range xsd:string ;
    rdfs:label "expected target" ;
    rdfs:comment "The qualified name subjectFeature's redefinition/specialization must resolve to." .

svt:groundedIn a owl:ObjectProperty ;
    rdfs:domain svt:TestCase ;
    rdfs:range svt:SpecCitation ;
    rdfs:label "grounded in" ;
    rdfs:comment "Multivalued: the SpecCitation(s) backing this TestCase's expected posterior state (svt:expected, or the svt:ResolutionCheck set). A TestCase with no groundedIn is an unsupported assertion -- ground it or leave expected unset (which mechanically records cantTell, never a guess dressed up as a claim)." .

#################################################################
# svt:Validation -- append-only, like StabilityDesignation. Being
# SHACL-valid RDF (structurally well-formed) is not the same thing as a
# human having actually confirmed a TestCase's claim against the spec.
# svt run refuses to run a TestCase with no Validation record -- see
# AGENTS.md's "construct -> SHACL-gate -> human-validate -> run" sequence.
#################################################################

svt:Validation a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Validation" ;
    rdfs:comment "A record that a named human reviewed a TestCase's claim (its description, expected posterior state, and groundedIn citations) against the actual spec text and confirmed it. Distinct from, and required in addition to, SHACL structural validity -- an LLM can construct SHACL-valid RDF with an invented claim; only a human Validation makes it trustworthy enough to run. prov:wasAssociatedWith must be a prov:Person, never this repo's own svt-cli prov:SoftwareAgent." .

svt:validates a owl:ObjectProperty ;
    rdfs:domain svt:Validation ;
    rdfs:range svt:TestCase ;
    rdfs:label "validates" .

svt:note a owl:DatatypeProperty ;
    rdfs:domain svt:Validation ;
    rdfs:range xsd:string ;
    rdfs:label "note" ;
    rdfs:comment "Optional free-text note from the validating human, e.g. what in the spec they checked." .

#################################################################
# svt:SpecDocument, svt:SpecCitation — the sources register
# (sources/sources.ttl). The PDFs themselves are held locally
# (sources/local/, gitignored); these records are what's committed.
#################################################################

svt:SpecDocument a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Spec document" ;
    rdfs:comment "A registered citation for a spec PDF held locally but not committed (OMG copyright) — its sha256 lets anyone confirm their own copy is the same edition." .

svt:docNumber a owl:DatatypeProperty ;
    rdfs:domain svt:SpecDocument ;
    rdfs:range xsd:string ;
    rdfs:label "doc number" ;
    rdfs:comment "The OMG formal document number, exactly as printed on the document's own cover page, e.g. \"formal/2026-03-02\" -- verify against the PDF, don't guess the format." .

svt:sha256 a owl:DatatypeProperty ;
    rdfs:domain svt:SpecDocument ;
    rdfs:range xsd:string ;
    rdfs:label "sha256" .

svt:localPath a owl:DatatypeProperty ;
    rdfs:domain svt:SpecDocument ;
    rdfs:range xsd:string ;
    rdfs:label "local path" ;
    rdfs:comment "Path under sources/local/ where this file lives once fetched — gitignored, not committed." .

svt:SpecCitation a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Spec citation" ;
    rdfs:comment "One verbatim excerpt of a SpecDocument, cited to ground a TestCase's svt:expected value. The quote is materialized here (not just a page reference) so the grounding is inspectable without re-opening the PDF -- same verbatim-canon-in-the-model discipline as cds and og-caie-spec." .

svt:citesDocument a owl:ObjectProperty ;
    rdfs:domain svt:SpecCitation ;
    rdfs:range svt:SpecDocument ;
    rdfs:label "cites document" .

svt:section a owl:DatatypeProperty ;
    rdfs:domain svt:SpecCitation ;
    rdfs:range xsd:string ;
    rdfs:label "section" ;
    rdfs:comment "The cited document's own section number and title, e.g. \"8.4.9.2 Connection Usages\"." .

svt:page a owl:DatatypeProperty ;
    rdfs:domain svt:SpecCitation ;
    rdfs:range xsd:string ;
    rdfs:label "page" ;
    rdfs:comment "The document's own printed page number(s), e.g. \"412-413\" -- not the PDF's physical page index, which can differ because of front matter." .

svt:quote a owl:DatatypeProperty ;
    rdfs:domain svt:SpecCitation ;
    rdfs:range xsd:string ;
    rdfs:label "quote" ;
    rdfs:comment "The verbatim cited text. Never paraphrased." .

svt:rationale a owl:DatatypeProperty ;
    rdfs:domain svt:SpecCitation ;
    rdfs:range xsd:string ;
    rdfs:label "rationale" ;
    rdfs:comment "Optional: connecting reasoning from the quote to the TestCase's expected value, used only when the quote alone doesn't state it outright (e.g. combining two rules, or an honest caveat about what the local sources do and don't settle). Never used to paper over a citation that isn't really there." .

#################################################################
# svt:TestRun
#################################################################

svt:TestRun a owl:Class ;
    rdfs:subClassOf earl:Assertion, prov:Activity ;
    rdfs:label "Test run" ;
    rdfs:comment "One earl:Assertion: a TestCase was run against a specific Version, and this is what actually happened. earl:test, earl:subject, earl:assertedBy, earl:mode and earl:result are inherited from earl:Assertion and used directly, never redefined. Timestamped with prov:startedAtTime, not prov:generatedAtTime (domain prov:Entity; this is a prov:Activity)." .

svt:Invocation a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Invocation" ;
    rdfs:comment "The exact command, exit code and environment of one adapter subprocess call, kept for reproducibility. Timestamped with prov:startedAtTime, for the same reason as TestRun." .

svt:hasInvocation a owl:ObjectProperty ;
    rdfs:domain svt:TestRun ;
    rdfs:range svt:Invocation ;
    rdfs:label "has invocation" ;
    rdfs:comment "Links a TestRun to the Invocation that produced it. Deliberately not prov:wasGeneratedBy: that property's rdfs:domain is prov:Entity, and both a TestRun and an Invocation are prov:Activity -- a domain-specific object property is the correct fit, not a borrowed one that doesn't." .

svt:command a owl:DatatypeProperty ;
    rdfs:domain svt:Invocation ;
    rdfs:range xsd:string ;
    rdfs:label "command" .

svt:exitCode a owl:DatatypeProperty ;
    rdfs:domain svt:Invocation ;
    rdfs:range xsd:integer ;
    rdfs:label "exit code" .

svt:stdout a owl:DatatypeProperty ;
    rdfs:domain svt:Invocation ;
    rdfs:range xsd:string ;
    rdfs:label "stdout" ;
    rdfs:comment "The complete, verbatim stdout captured from the adapter's subprocess/call. Never summarized or truncated -- this, not earl:info, is the precise evidentiary record." .

svt:stderr a owl:DatatypeProperty ;
    rdfs:domain svt:Invocation ;
    rdfs:range xsd:string ;
    rdfs:label "stderr" ;
    rdfs:comment "The complete, verbatim stderr captured from the adapter's subprocess/call. Never summarized or truncated." .

svt:inputDigest a owl:DatatypeProperty ;
    rdfs:domain svt:Invocation ;
    rdfs:range xsd:string ;
    rdfs:label "input digest" ;
    rdfs:comment "sha256 over the exact bytes of the TestCase's input files (concatenated in sorted-filename order) as actually fed to the tool -- pins precisely which input bytes this Invocation ran against, independent of whatever state the fixture files are in later." .

svt:actual a owl:DatatypeProperty ;
    rdfs:domain earl:TestResult ;
    rdfs:range xsd:string ;
    rdfs:label "actual" ;
    rdfs:comment "The literal value the method's comparator (adapters/compare.py) actually computed from the captured output, before comparing it to the TestCase's svt:expected. Lets a reader see exactly what was compared without re-deriving it from raw stdout." .
