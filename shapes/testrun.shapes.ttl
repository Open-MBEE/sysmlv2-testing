@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix svt: <https://w3id.org/sysmlv2-testing#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

svt:TestRunShape a sh:NodeShape ;
    sh:targetClass svt:TestRun ;
    sh:property svt:TestRunTestShape, svt:TestRunSubjectShape, svt:TestRunAssertedByShape,
        svt:TestRunModeShape, svt:TestRunResultShape, svt:TestRunStartedAtTimeShape,
        svt:TestRunHasInvocationShape, svt:TestRunRanByShape,
        svt:TestRunReconfirmedAtShape .

# Optional, unlike a Reproduction's: absence means "unattributed", which is
# a real value, not a gap to fill in. The runs recorded before Party existed
# are unattributed and stay that way -- backfilling them would assert
# provenance that was never captured, which is a different thing from it
# being true.
svt:TestRunRanByShape a sh:PropertyShape ;
    sh:path svt:ranBy ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class svt:Party ;
    sh:message "svt:ranBy, when present, must be exactly one svt:Party" .

# Multivalued on purpose -- one timestamp per same-party re-run that agreed.
svt:TestRunReconfirmedAtShape a sh:PropertyShape ;
    sh:path svt:reconfirmedAt ;
    sh:datatype xsd:dateTime ;
    sh:message "svt:reconfirmedAt values must be xsd:dateTime (multivalued -- one per same-party re-run that produced the identical result)" .

svt:TestRunTestShape a sh:PropertyShape ;
    sh:path earl:test ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class svt:TestCase ;
    sh:message "a TestRun must have exactly one earl:test, pointing at a svt:TestCase" .

svt:TestRunSubjectShape a sh:PropertyShape ;
    sh:path earl:subject ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class svt:Version ;
    sh:message "a TestRun must have exactly one earl:subject, pointing at the exact svt:Version tested" .

svt:TestRunAssertedByShape a sh:PropertyShape ;
    sh:path earl:assertedBy ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "a TestRun must have exactly one earl:assertedBy" .

svt:TestRunModeShape a sh:PropertyShape ;
    sh:path earl:mode ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( earl:automatic earl:manual ) ;
    sh:message "earl:mode must be earl:automatic or earl:manual" .

svt:TestRunResultShape a sh:PropertyShape ;
    sh:path earl:result ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class earl:TestResult ;
    sh:message "a TestRun must have exactly one earl:result" .

svt:TestRunStartedAtTimeShape a sh:PropertyShape ;
    sh:path prov:startedAtTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
    sh:message "a TestRun must record exactly one prov:startedAtTime" .

svt:TestRunHasInvocationShape a sh:PropertyShape ;
    sh:path svt:hasInvocation ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class svt:Invocation ;
    sh:message "a TestRun must have exactly one svt:hasInvocation, pointing at the svt:Invocation that produced it" .

svt:TestResultShape a sh:NodeShape ;
    sh:targetClass earl:TestResult ;
    sh:property svt:TestResultOutcomeShape, svt:TestResultActualShape .

svt:TestResultOutcomeShape a sh:PropertyShape ;
    sh:path earl:outcome ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( earl:passed earl:failed earl:cantTell earl:inapplicable earl:untested ) ;
    sh:message "earl:outcome must be exactly one of the five canonical EARL outcomes" .

svt:TestResultActualShape a sh:PropertyShape ;
    sh:path svt:actual ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "svt:actual, when present, must be a single literal" .

# svt:Invocation: named shapes, per the repo's convention -- every field
# here is required and typed so it's queryable on its own, not just baked
# into a single earl:info blob (see AGENTS.md's "precise input, precise
# output" discipline).

svt:InvocationShape a sh:NodeShape ;
    sh:targetClass svt:Invocation ;
    sh:property svt:InvocationCommandShape, svt:InvocationExitCodeShape,
        svt:InvocationStdoutShape, svt:InvocationStderrShape,
        svt:InvocationInputDigestShape, svt:InvocationStartedAtTimeShape .

svt:InvocationCommandShape a sh:PropertyShape ;
    sh:path svt:command ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "an Invocation must record exactly one svt:command" .

svt:InvocationExitCodeShape a sh:PropertyShape ;
    sh:path svt:exitCode ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:message "an Invocation must record exactly one svt:exitCode" .

svt:InvocationStdoutShape a sh:PropertyShape ;
    sh:path svt:stdout ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "an Invocation must record exactly one svt:stdout (may be an empty string, but must be present -- never omitted in favor of a summary elsewhere)" .

svt:InvocationStderrShape a sh:PropertyShape ;
    sh:path svt:stderr ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "an Invocation must record exactly one svt:stderr (may be an empty string, but must be present)" .

svt:InvocationInputDigestShape a sh:PropertyShape ;
    sh:path svt:inputDigest ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-9a-f]{64}$" ;
    sh:message "svt:inputDigest must be a lowercase-hex sha256 (64 chars), required and exactly one" .

svt:InvocationStartedAtTimeShape a sh:PropertyShape ;
    sh:path prov:startedAtTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
    sh:message "an Invocation must record exactly one prov:startedAtTime" .
