@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix svt: <https://w3id.org/sysmlv2-testing#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Every property shape is named (never an anonymous blank node) so a SHACL
# violation's sh:sourceShape identifies exactly which check fired, by name.

svt:ImplementationShape a sh:NodeShape ;
    sh:targetClass svt:Implementation ;
    sh:property svt:ImplementationNameShape, svt:ImplementationRepositoryURLShape,
        svt:ImplementationPrimaryLanguageShape .

svt:ImplementationNameShape a sh:PropertyShape ;
    sh:path svt:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "an Implementation must have exactly one svt:name" .

svt:ImplementationRepositoryURLShape a sh:PropertyShape ;
    sh:path svt:repositoryURL ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "an Implementation must have exactly one svt:repositoryURL" .

svt:ImplementationPrimaryLanguageShape a sh:PropertyShape ;
    sh:path svt:primaryLanguage ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "an Implementation must have exactly one svt:primaryLanguage" .
